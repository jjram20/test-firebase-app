project_id = "frida-piston"
region     = "us-central1"
zone       = "us-central1-a"
environment = "dev"

network_cidr      = "10.10.1.0/24"
piston_internal_ip = "10.10.1.2"
machine_type       = "e2-standard-2"

min_replicas = 0
max_replicas = 3

# Incluya aquí el rango del Serverless VPC Access connector usado por
# Cloud Run o Firebase Functions, además de cualquier subred administrativa.
client_source_ranges = [
  "10.8.0.0/28",
  "10.10.1.0/24"
]